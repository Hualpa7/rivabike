# Cliente (expuesto en el bundle del navegador — usar SOLO claves publicas)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_PLACE_ID=

# Convencion mock-first (ver docs/data-contract.md): mientras sea "true",
# cada hook usa su implementacion *.mock.ts en vez de *.supabase.ts. Se pasa
# a "false" recien en el prompt de Integracion.
VITE_USE_MOCKS=true

# NUNCA agregar aca:
# - service role key de Supabase
# - secrets de Google (si se necesitara alguno server-side)
# Esas credenciales van exclusivamente en Supabase Edge Functions / Supabase secrets.
